	<template>
		<name>CommandClient</name>
		<parameter>const drone_id id</parameter>
		<declaration>// GCS side of the command protocol for drone id.
// Sends one COMMAND and waits for its COMMAND_ACK.
// No ACK after ACK_TIMEOUT: sends the COMMAND again (at most MAX_RETRY times),
// then gives up in Failed.
// Late ACKs (from an earlier try, arriving after a timeout) are accepted
// and ignored by the loops, otherwise the network would stay blocked.

// Command currently being handled
cmd_id current = 0;
// Re-sends done for the current command
int[0,MAX_RETRY] retries = 0;
// Time since the last send
clock x;</declaration>
		<location id="id200" x="0" y="0">
			<name x="-30" y="-34">Idle</name>
		</location>
		<location id="id201" x="300" y="0">
			<name x="270" y="-34">Sending</name>
		</location>
		<location id="id202" x="600" y="0">
			<name x="570" y="-34">WaitAck</name>
			<label kind="invariant" x="570" y="17">x &lt;= ACK_TIMEOUT</label>
		</location>
		<location id="id203" x="950" y="0">
			<name x="920" y="-34">Failed</name>
		</location>
		<init ref="id200"/>
		<transition id="id204">
			<source ref="id200"/>
			<target ref="id201"/>
			<label kind="select" x="20" y="-70">c : cmd_id</label>
			<label kind="synchronisation" x="20" y="-53">begin_command[id][c]?</label>
			<label kind="assignment" x="20" y="-36">current = c, retries = 0</label>
		</transition>
		<transition id="id205">
			<source ref="id201"/>
			<target ref="id202"/>
			<label kind="synchronisation" x="330" y="-36">cmd_tx[id][current]!</label>
			<label kind="assignment" x="330" y="-19">x = 0</label>
		</transition>
		<transition id="id206">
			<source ref="id202"/>
			<target ref="id201"/>
			<label kind="guard" x="330" y="-200">x &gt;= ACK_TIMEOUT &amp;&amp; retries &lt; MAX_RETRY</label>
			<label kind="assignment" x="330" y="-183">retries++</label>
			<nail x="600" y="-150"/>
			<nail x="300" y="-150"/>
		</transition>
		<transition id="id207">
			<source ref="id202"/>
			<target ref="id203"/>
			<label kind="guard" x="640" y="-53">x &gt;= ACK_TIMEOUT &amp;&amp; retries == MAX_RETRY</label>
