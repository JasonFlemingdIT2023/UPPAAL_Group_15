	<template>
		<name>CommandServer</name>
		<parameter>const drone_id id</parameter>
		<declaration>// Drone side of the command protocol for drone id.
// Checks a received COMMAND and answers with COMMAND_ACK.
// A COMMAND that arrives while the previous one is still being answered
// (a re-send after a timeout) is ignored: the answer on its way covers it.

// Command currently being handled
cmd_id current = 0;

// Can the drone execute this command now?
bool canExecute(cmd_id c) {
    if (c == ARM) {
        return missionInstalled[id];   // ARM: a mission must be installed
    }
    return armed[id];                  // START: the drone must be armed
}

// Effect of an accepted command on the real drone state
void execute(cmd_id c) {
    if (c == ARM) {
        armed[id] = true;
    } else {
        started[id] = true;
    }
}</declaration>
		<location id="id300" x="0" y="0">
			<name x="-30" y="-34">Idle</name>
		</location>
		<location id="id301" x="350" y="0">
			<name x="320" y="-34">Decide</name>
		</location>
