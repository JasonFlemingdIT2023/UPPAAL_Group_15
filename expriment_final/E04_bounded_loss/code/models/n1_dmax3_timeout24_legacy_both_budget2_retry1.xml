	<declaration>// Place global declarations here.

//---------
//Channels and variables for the base model
//---------
//Model size
const int N = 1;
//Mission budget
const int MISSION_SIZE = 3;


typedef int[0,N-1] drone_id;
typedef int[0, MISSION_SIZE-1] item_id;


// --------
// Channels and Variables regarding the Mission Protocol
//---------
// internal gcs interaction
chan begin_upload[N];
// network interfaces and channels for mission announcments, sending and delivery, state between network
chan count_tx[N];
chan count_rx[N];

chan item_tx[N][MISSION_SIZE];
chan item_rx[N][MISSION_SIZE];

chan ack_tx[N];
chan ack_rx[N];

//Channels for item requests of drones
chan request_tx[N][MISSION_SIZE];
chan request_rx[N][MISSION_SIZE];

//Variable to perceive if the item transfer is done
bool uploadDone[N];


//---------
// Channels and variables regarding the Heartbeat Protocol
//---------
const int HB_PERIOD = 20;

// Drone sends the heartbeat to network under the urgent scheduling assumption
urgent chan heartbeat_tx[N];
chan heartbeat_rx[N];
// has it arrived at GCS
bool heartbeatSeen[N];



// ***************************************************************************
// * MAVLink COMMAND protocol (COMMAND / COMMAND_ACK)  - model 03            *
// * After Prepared, the GCS sends ARM to every drone, then START.           *
// * CommandClient = GCS side, CommandServer = drone side.                   *
// ***************************************************************************

// Test setting: true = the network may lose any command-protocol message
// (COMMAND or COMMAND_ACK). Mission-protocol messages are never lost.
const int LOSS_BUDGET = 2;
const bool LOSSY = true;

const int NB_CMD = 2;
typedef int[0,NB_CMD-1] cmd_id;
const int ARM = 0;
const int START = 1;

// Timeout and retry (CommandClient)
// Existing client timeout; recheck with variable delay and heartbeat traffic.
const int ACK_TIMEOUT = 24;
const int MAX_RETRY = 1;              // re-sends after the first try (3 tries in total)

// "urgent chan": the synchronisation happens as soon as both sides are ready
// (time cannot pass while it is possible), but time CAN pass while the
// network is busy. An urgent location would forbid that and cause a timelock.
// Supervisor -&gt; CommandClient (internal GCS request)
urgent chan begin_command[N][NB_CMD];

// COMMAND: CommandClient -&gt; network -&gt; CommandServer
urgent chan cmd_tx[N][NB_CMD];
chan cmd_rx[N][NB_CMD];

// COMMAND_ACK accepted / denied: CommandServer -&gt; network -&gt; CommandClient
urgent chan accepted_tx[N][NB_CMD], denied_tx[N][NB_CMD];
chan accepted_rx[N][NB_CMD], denied_rx[N][NB_CMD];

// Broadcast with no receiver: forces the supervisor to move on as soon as
// its guard is true (instead of possibly waiting forever)
urgent broadcast chan hurry;

// What the GCS knows (set by CommandClient)
bool cmdAccepted[N][NB_CMD];
bool cmdDenied[N][NB_CMD];
bool cmdFailed[N][NB_CMD];  // no ACK after all the tries

// What is really true on the drone (set by CommandServer)
bool armed[N];
bool started[N];

// Set by MissionReceiver when its mission is complete (on the ACK edge)
bool missionInstalled[N];



//---------
//Channels and Variables for the standalone network implementation and conncetion to protcols
//---------
// endpoint adresses
const int N_ENDPOINTS = N + 1;
const int GCS_ENDPOINT = 0;
typedef int[0, N_ENDPOINTS-1] endpoint_id;

//Packet Kinds

const int N_KINDS = 8;
typedef int[0,N_KINDS-1] kind_id;
//internal model and not MAVLink message norm
const int PK_COUNT = 0;
const int PK_REQUEST = 1;
const int PK_ITEM = 2;
const int PK_MISSION_ACK = 3;
const int PK_COMMAND = 4;
const int PK_ACCEPTED = 5;
const int PK_DENIED = 6;
const int PK_HEARTBEAT = 7;

//packet structure
typedef struct {
   endpoint_id src;
    endpoint_id dst;
    kind_id kind;
    drone_id peer;
    item_id seq; //regards mission perotcol
    int[0, MISSION_SIZE] count;
    cmd_id cmd;// regards cmd protocol
} packet_t;

// Transmission window in model time units
const int D_MIN = 1;
const int D_MAX = 3;
</declaration>
	<template>
		<name>PacketNetwork</name>
		<declaration>clock t;
packet_t packet;
int[0, LOSS_BUDGET] lossCount = 0;

void storePacket(drone_id d, kind_id k, item_id s, cmd_id c) {
    packet.peer = d;
    packet.kind = k;
    packet.seq = s;
    packet.cmd = c;
    packet.count = (k == PK_COUNT ? MISSION_SIZE : 0);
    if (k == PK_COUNT || k == PK_ITEM || k == PK_COMMAND) {
        packet.src = GCS_ENDPOINT;
        packet.dst = d + 1;
    } else {
        packet.src = d + 1;
        packet.dst = GCS_ENDPOINT;
    }
}
</declaration>
